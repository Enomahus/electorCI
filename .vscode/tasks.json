  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "path": "src/front/web-client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      },
      "label": "npm: start - src/front/web-client",
      "detail": "ng serve"
    },
    {
      "type": "npm",
      "script": "lint",
      "path": "src/front/web-client",
      "problemMatcher": [],
      "label": "npm: lint - src/front/web-client",
      "detail": "ng lint"
    },
    {
      "type": "npm",
      "script": "lint-fix",
      "path": "src/front/web-client",
      "problemMatcher": [],
      "label": "npm: lint auto fix - src/front/web-client",
      "detail": "ng lint-fix"
    },
    {
      "type": "npm",
      "script": "generate-api-client",
      "path": "src/front/web-client",
      "problemMatcher": [],
      "label": "Generate nswag api client"
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Name of migration"
    }
  ]
}
