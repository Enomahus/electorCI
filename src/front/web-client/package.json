{
  "name": "web-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=44026",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint --fix",
    "generate-api-client": "nswag run ./server.nswag.json",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/aria": "^21.2.8",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/google.accounts": "^0.0.18",
    "@types/node": "^26.0.1",
    "google-libphonenumber": "^3.2.44",
    "jwt-decode": "^4.0.0",
    "lint": "^1.2.2",
    "ngx-toastr": "^20.0.5",
    "nswag": "^14.7.1",
    "prettier": "^3.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript-eslint": "^8.62.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.0.5",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
